# ============================================================
# PLANTILLA del archivo de variables del servidor.
#
# El de verdad va en /srv/portal/.env, con dueño root y permisos 600,
# y NO existe en el repositorio. Este archivo solo dice qué lleva.
#
#   install -o root -g root -m 600 /dev/null /srv/portal/.env
#
# Sé honesto sobre lo que esto protege: quien tiene root en la máquina
# puede leerlo. Evita el vistazo casual —alguien de sistemas del cliente
# curioseando—, no a alguien decidido. Lo que de verdad no sale de aquí
# son las credenciales que son de ESEK, y esas no se ponen en este
# archivo: el token de GHCR es de solo lectura y vive en la
# configuración de docker, no aquí.
# ============================================================

# ── Qué versión corre ──
# La etiqueta de la imagen. Se cambia a mano al actualizar y por eso se
# sabe siempre qué está corriendo. NUNCA `latest`.
VERSION=v1

# ── La base ──
# La clave la genera ESEK, se le entrega al cliente POR ESCRITO y es
# suya. Para generar una:  openssl rand -base64 32
POSTGRES_DB=costamallas
POSTGRES_USER=costamallas
POSTGRES_PASSWORD=

# `postgres` es el nombre del servicio en compose.yml, no un dominio:
# solo se resuelve dentro de la red de docker, que es justo lo que se
# quiere. Las dos apuntan a la misma base porque aquí no hay pooler —
# eso era cosa de Supabase.
DATABASE_URL=postgresql://costamallas:LA_CLAVE@postgres:5432/costamallas?schema=public
DIRECT_URL=postgresql://costamallas:LA_CLAVE@postgres:5432/costamallas?schema=public

# ── Los enlaces que arma el servidor ──
# Sin petición delante (la corrida de cron) no hay de dónde sacar el
# dominio. Ver src/lib/url-portal.ts.
PORTAL_URL=https://portal.costamallas.com
COTIZACION_URL=https://cotizacion.costamallas.com
ACME_EMAIL=

# ── Las llaves de la instalación ──
#
# ⚠️ TIENEN QUE SER LAS MISMAS QUE HAY EN VERCEL, exactas.
#
# Con unas nuevas, lo que está cifrado en la base —la contraseña del
# SMTP, el token de WhatsApp, las llaves de WooCommerce— queda ilegible.
# Y no da error: los correos simplemente dejan de salir. Es el fallo más
# caro de esta migración y el más silencioso.
#
# Las dos se le entregan al cliente en el sobre de cierre si algún día
# se acaba la relación: sin ellas se queda con una base que nadie puede
# descifrar, y eso, además de feo, se pelea.
ENCRYPTION_KEY=
JWT_SECRET=

# ── El reloj ──
# El mismo valor que tenía en Vercel: lo usan las líneas del crontab.
CRON_SECRET=

# ── Lo que es del cliente y está bien que sea suyo ──
# Se bajan de Vercel con `vercel env pull`. Correo, WhatsApp, WooCommerce,
# la IA, el FTP del catálogo. Están aquí solo nombradas: los valores no
# se escriben en un archivo que va al repositorio.
#
#   SMTP_HOST SMTP_PORT SMTP_USER SMTP_PASS
#   WHATSAPP_TOKEN WHATSAPP_PHONE_ID WHATSAPP_VERIFY_TOKEN
#   WOO_URL WOO_KEY WOO_SECRET
#   ANTHROPIC_API_KEY
#   FTP_HOST FTP_USER FTP_PASS FTP_BASE_URL
#   NEXT_PUBLIC_APP_URL   ← ojo: apunta a la TIENDA, no al portal

# ── El respaldo de fuera de la máquina ──
# El proyecto de Supabase queda libre al traerse la base al VPS: se
# aprovecha para guardar los volcados. Ver respaldo.sh.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=respaldos

# ── Arranque ──
# 1 = aplica las migraciones pendientes antes de levantar, y si fallan
# NO levanta. Ponerlo en 0 solo para depurar.
MIGRAR_AL_ARRANCAR=1
