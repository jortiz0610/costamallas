# ============================================================
# El HTTPS del portal. Va en /srv/caddy/Caddyfile.
#
# Caddy pide el certificado a Let's Encrypt la primera vez que alguien
# entra al dominio, y lo renueva solo. No hay que acordarse de nada.
#
# ⚠️ Esto NO funciona hasta que el DNS apunte al VPS: Let's Encrypt
# comprueba que el dominio es de esta máquina entrando por el puerto 80.
# Por eso el DNS va de último en la migración, y por eso el corte del
# chat de la web ocurre en ese mismo momento (el widget que está pegado
# en WordPress carga desde portal.costamallas.com).
# ============================================================

{
	email {$ACME_EMAIL}
	# Un solo registro, en formato de texto: lo que hace falta para
	# mirarlo con `docker compose logs caddy` cuando un certificado no
	# sale.
	log {
		format console
	}
}

# Los dominios salen de la variable DOMINIOS del .env, separados por
# coma. Todos sirven la MISMA aplicación.
#
# Se hace así por la migración: primero se prueba en el host que da
# Hostinger (srv1950440.hstgr.cloud), con HTTPS de verdad y SIN tocar el
# DNS de la empresa. El día del corte se cambia esa línea del .env y se
# reinicia Caddy; no hay dos configuraciones que mantener.
#
# El reparto final, confirmado el 7-sep-2026:
#
#   portal.costamallas.com        el portal interno, para el equipo
#   cotizaciones.costamallas.com  la oferta que recibe el CLIENTE
#
# Son el mismo servidor y la misma aplicación: quien decide qué se
# sirve es la ruta. El segundo existe porque lo que se le manda a un
# cliente por correo o WhatsApp es un enlace, y un enlace a `portal.`
# invita a curiosear el portal interno; un subdominio dedicado deja
# claro que ahí solo hay una cosa, su oferta.
#
# **En plural.** Es el registro que existe. En singular no hay nada, y
# este nombre se queda escrito en cada enlace ya enviado.
{$DOMINIOS} {
	encode zstd gzip

	reverse_proxy portal:3000 {
		# Sin esto, `urlPortal()` arma los enlaces con el host interno
		# del contenedor y los correos salen apuntando a `portal:3000`.
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}

		# Subir una firma o un documento de SG-SST tarda más que una
		# petición normal desde un teléfono con media barra de señal.
		transport http {
			read_timeout 120s
			write_timeout 120s
		}
	}

	# Las cabeceras de seguridad las pone Next (next.config.ts). Aquí
	# solo se quita la que delata con qué está hecho el servidor.
	header {
		-Server
	}

	log {
		output file /data/acceso.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}
