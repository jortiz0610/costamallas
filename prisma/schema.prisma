enum TipoNotificacion {
  STOCK_CRITICO
  STOCK_BAJO
  ERROR_VALIDACION
  EXPORTACION_COMPLETA
  SYNC_WOOCOMMERCE
  SISTEMA
  NEXUS_MENSAJE
}

// ─────────────────────────────────────────────
// NEXUS — HUB OMNICANAL
// ─────────────────────────────────────────────

model NexusConexion {
  id          String   @id @default(cuid())
  canal       String
  nombre      String
  descripcion String?
  config      Json     @default("{}")
  activo      Boolean  @default(true)
  webhookUrl  String?
  asignadoId  String? // usuario que atiende esta línea/canal (asignado por admin)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conversaciones NexusConversacion[]

  @@index([canal])
  @@index([activo])
  @@index([asignadoId])
  @@map("nexus_conexiones")
}

model NexusConversacion {
  id         String        @id @default(cuid())
  conexionId String
  conexion   NexusConexion @relation(fields: [conexionId], references: [id], onDelete: Cascade)
  canal      String
  remitente  String
  emailRemit String?
  telRemit   String?
  asunto     String?
  estado     String        @default("ABIERTA")
  prioridad  String        @default("NORMAL")
  asignadoId String? // usuario asignado (por turno o transferido)
  leida      Boolean       @default(false)
  metadata   Json?

  /// Lo que el bot saca del primer mensaje: producto, ciudad, urgencia.
  etiquetas          String[]  @default([])
  /// Vínculo con el CRM: saber que quien escribe ya es cliente cambia
  /// por completo cómo se le atiende.
  clienteId          String?
  cliente            Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  /// Cuándo contestó un humano por primera vez. Es lo que permite medir
  /// el compromiso de responder en una hora.
  primeraRespuestaEn DateTime?
  /// Sello del aviso por incumplir el compromiso. Sin él, la corrida
  /// diaria mandaría el mismo aviso todos los días hasta que alguien
  /// conteste, y un aviso que se repite deja de leerse a la tercera vez.
  alertaTiempoEn     DateTime?

  /// Secreto con el que el navegador del cliente retoma SU conversación
  /// con el agente de la web. No se puede usar el id: con uno cualquiera
  /// se leería la conversación de otra persona.
  tokenWeb           String?   @unique
  /// Lo que lleva gastado esta conversación en IA. Permite cortar una
  /// charla que se fue de precio sin sumar toda la tabla en cada mensaje.
  costoUSD           Float     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mensajes NexusMensaje[]

  @@index([conexionId])
  @@index([estado])
  @@index([leida])
  @@index([asignadoId])
  @@index([createdAt])
  @@map("nexus_conversaciones")
}

model NexusMensaje {
  id             String            @id @default(cuid())
  conversacionId String
  conversacion   NexusConversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  agenteId       String?
  agente         Usuario?          @relation(fields: [agenteId], references: [id], onDelete: SetNull)
  origen         String
  contenido      String            @db.Text
  tipo           String            @default("texto")
  metadata       Json?
  leido          Boolean           @default(false)

  /// RECIBIDO (entró del contacto) · ENVIADO · PENDIENTE · ERROR.
  /// Sin esto, que la API del canal rechazara el mensaje era invisible:
  /// el asesor veía su respuesta en pantalla y el cliente nunca la recibía.
  estadoEnvio String  @default("RECIBIDO")
  errorEnvio  String? @db.Text
  /// Id del mensaje en el canal (wamid en WhatsApp).
  refExterna  String?

  createdAt DateTime @default(now())

  @@index([conversacionId])
  @@index([createdAt])
  @@map("nexus_mensajes")
}

// ─────────────────────────────────────────────
// REPORTES DE ERROR (enviados por usuarios)
// ─────────────────────────────────────────────

model ReporteError {
  id            String   @id @default(cuid())
  usuarioId     String?
  usuarioNombre String
  usuarioRol    String
  modulo        String // ruta/ubicación (pathname)
  accion        String? // qué estaba haciendo
  descripcion   String?  @db.Text
  url           String?
  userAgent     String?
  estado        String   @default("NUEVO") // NUEVO, EN_REVISION, RESUELTO
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([estado])
  @@index([createdAt])
  @@map("reportes_error")
}
