// ============================================================
// COSTAMALLAS ERP — Prisma Schema
// Base de datos: PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// USUARIOS Y AUTENTICACIÓN
// ─────────────────────────────────────────────

model Usuario {
  id           String    @id @default(cuid())
  nombre       String
  email        String    @unique
  password     String // bcrypt hash — nunca texto plano
  rol          Rol       @default(USUARIO)
  activo       Boolean   @default(true)
  /// Celular del asesor. Sale en la cotización y es el número al que
  /// llega el botón de WhatsApp que ve el cliente en la oferta.
  telefono     String?
  ultimoAcceso DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Solo para rol CLIENTE: ficha del CRM a la que está atado este login.
  // Sembli usa este vínculo para mostrarle únicamente SUS pedidos.
  clienteId     String?
  clientePropio Cliente? @relation("LoginDelCliente", fields: [clienteId], references: [id], onDelete: SetNull)

  logs              Log[]
  clientesAsignados Cliente[]
  cotizaciones      Cotizacion[]
  pedidos           Pedido[]
  instalaciones     Instalacion[]
  nexusMensajes     NexusMensaje[]
  tareas            Tarea[]
  permisos          PermisoUsuario[]
  chatsInternos     ChatInternoMiembro[]
  mensajesInternos  ChatInternoMensaje[]

  @@index([email])
  @@index([clienteId])
  @@map("usuarios")
}

/// Excepciones de permisos de UNA persona. El juego por defecto lo trae
/// el rol y vive en código (lib/permisos.ts); aquí solo se guarda lo
/// que se le activó o se le quitó a mano. Guardar el juego completo por
/// usuario haría que una pantalla nueva no la viera nadie.
model PermisoUsuario {
  id        String  @id @default(cuid())
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// Clave del catálogo: "erp.stock", "erp.productos.editar"…
  clave     String
  /// true = concedido aunque el rol no lo traiga.
  /// false = retirado aunque el rol sí lo traiga.
  permitido Boolean

  /// Quién lo cambió y por qué. Un permiso suelto que nadie recuerda
  /// haber dado es la forma más común de que se quede puesto para siempre.
  otorgadoPorId String?
  nota          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([usuarioId, clave])
  @@index([usuarioId])
  @@map("permisos_usuario")
}

enum Rol {
  SUPERADMIN
  ADMIN
  MARKETING
  VENDEDOR
  PRODUCCION
  CLIENTE // login del cliente final: solo su propia información

  // Retirados el 29-ago. NO se borran del enum: quitar un valor de un
  // enum de Postgres es DDL destructivo y falla si alguien lo tiene
  // puesto — y hay dos personas activas en SOLO_LECTURA. Dejan de
  // ofrecerse en el portal (lib/permisos.ts) y quien los tenga sigue
  // viendo lo mismo. Ver PENDIENTES §17.
  USUARIO
  BODEGA
  SOLO_LECTURA
}

// ─────────────────────────────────────────────
// CHAT INTERNO
// ─────────────────────────────────────────────

/// Hablar con el equipo dentro del portal.
///
/// Tablas propias y no una conexión más de Nexus: una conversación de
/// Nexus tiene remitente, canal, cliente y un tiempo de respuesta
/// comprometido. Un chat entre dos compañeros no tiene nada de eso, y
/// meterlo ahí ensuciaría el informe de tiempos con conversaciones que
/// no son de ningún cliente.
model ChatInterno {
  id     String  @id @default(cuid())
  /// DIRECTO (dos personas) o GRUPO.
  tipo   String  @default("DIRECTO")
  /// Solo los grupos llevan nombre: un chat directo se nombra con la
  /// otra persona, y eso depende de quién lo esté mirando.
  nombre String?

  creadoPorId String?

  /// Se sella con cada mensaje para poder ordenar la lista sin mirar
  /// dentro de cada chat.
  ultimoMensajeEn DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  miembros ChatInternoMiembro[]
  mensajes ChatInternoMensaje[]

  @@index([ultimoMensajeEn])
  @@map("chat_interno")
}

model ChatInternoMiembro {
  id        String      @id @default(cuid())
  chatId    String
  chat      ChatInterno @relation(fields: [chatId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// Hasta dónde leyó ESTA persona. Es lo que decide el contador de sin
  /// leer, y por eso va por miembro y no por chat.
  ultimaLecturaEn DateTime?

  createdAt DateTime @default(now())

  @@unique([chatId, usuarioId])
  @@index([usuarioId])
  @@map("chat_interno_miembros")
}

model ChatInternoMensaje {
  id        String      @id @default(cuid())
  chatId    String
  chat      ChatInterno @relation(fields: [chatId], references: [id], onDelete: Cascade)
  autorId   String
  autor     Usuario     @relation(fields: [autorId], references: [id], onDelete: Cascade)

  contenido  String  @db.Text
  /// texto · imagen · archivo · audio
  tipo       String  @default("texto")
  adjuntoUrl String?

  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
  @@map("chat_interno_mensajes")
}

// ─────────────────────────────────────────────
// CRM
// ─────────────────────────────────────────────

model Cliente {
  id           String   @id @default(cuid())
  nombre       String
  empresa      String?
  cargo        String?
  email        String?
  telefono     String?
  whatsapp     String?
  ciudad       String?
  departamento String?
  direccion    String?
  nit          String?
  /// Documento del cliente persona natural. `nit` es para empresas y
  /// solo se pedia en ese caso: una persona quedaba sin identificacion,
  /// y sin identificacion no se le puede facturar.
  cedula       String?
  paginaWeb    String?
  tipo         String   @default("persona")
  estado       String   @default("PROSPECTO")
  /// Lo más reciente de todo lo que cuenta como señal de vida:
  /// cotización, pedido o mensaje en el chat. Se guarda en vez de
  /// calcularse en cada consulta porque ordena la lista y decide si
  /// alguien lleva seis meses callado.
  ultimaInteraccionEn DateTime?
  /// Cuándo se recalculó el estado. Sin esto, un estado raro no se
  /// distingue de un estado viejo.
  estadoCalculadoEn   DateTime?
  notas        String?  @db.Text
  vendedorId   String?
  vendedor     Usuario? @relation(fields: [vendedorId], references: [id], onDelete: SetNull)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cotizaciones   Cotizacion[]
  pedidos        Pedido[]
  tareas         Tarea[]
  facturas       Factura[]
  logins         Usuario[]           @relation("LoginDelCliente")
  conversaciones NexusConversacion[]
  encuestas      EncuestaSatisfaccion[]

  @@index([vendedorId])
  @@index([activo])
  @@index([estado])
  /// Cliente de CAPACITACIÓN. Todo lo que cuelgue de él —cotizaciones,
  /// pedidos, visitas, instalaciones, facturas— nace marcado y recorre el
  /// proceso completo, sin entrar en informes ni quemar consecutivos.
  esPrueba Boolean @default(false)

  @@index([esPrueba])

  @@map("clientes")
}

// ─────────────────────────────────────────────
// FACTURACIÓN (base + electrónica vía tercero/DIAN)
// ─────────────────────────────────────────────

model Factura {
  id          String  @id @default(cuid())
  numero      String  @unique
  prefijo     String?
  consecutivo Int?

  clienteId    String
  cliente      Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  pedidoId     String?
  cotizacionId String?

  estado       String  @default("BORRADOR")
  estadoDian   String  @default("NO_APLICA")
  cufe         String?
  proveedorRef String?
  qrUrl        String?
  xmlUrl       String?
  pdfUrl       String?
  mensajeDian  String? @db.Text

  subtotal  Decimal @default(0) @db.Decimal(14, 2)
  descuento Decimal @default(0) @db.Decimal(14, 2)
  iva       Decimal @default(0) @db.Decimal(14, 2)
  total     Decimal @default(0) @db.Decimal(14, 2)

  formaPago      String?
  metodoPago     String?
  saldoPendiente Decimal   @default(0) @db.Decimal(14, 2)
  fechaEmision   DateTime?
  fechaVence     DateTime?

  notas String?       @db.Text
  items ItemFactura[]
  pagos PagoFactura[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clienteId])
  @@index([estado])
  @@index([estadoDian])
  @@index([pedidoId])
  /// Heredado del cliente o del pedido.
  esPrueba Boolean @default(false)

  @@index([esPrueba])

  @@map("facturas")
}

model ItemFactura {
  id             String  @id @default(cuid())
  facturaId      String
  factura        Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  productoId     String?
  descripcion    String
  cantidad       Decimal @db.Decimal(10, 2)
  precioUnitario Decimal @db.Decimal(14, 2)
  descuento      Decimal @default(0) @db.Decimal(5, 2)
  ivaPct         Decimal @default(19) @db.Decimal(5, 2)
  subtotal       Decimal @db.Decimal(14, 2)
  unidad         String?
  orden          Int     @default(0)

  @@index([facturaId])
  @@map("items_factura")
}

model PagoFactura {
  id         String   @id @default(cuid())
  facturaId  String
  factura    Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  monto      Decimal  @db.Decimal(14, 2)
  metodo     String   @default("TRANSFERENCIA")
  referencia String?
  fecha      DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([facturaId])
  @@map("pagos_factura")
}

// ── Tareas y seguimientos (submódulo CRM) ──
model Tarea {
  id           String    @id @default(cuid())
  titulo       String
  descripcion  String?   @db.Text
  tipo         String    @default("SEGUIMIENTO") // SEGUIMIENTO, LLAMADA, EMAIL, REUNION, COTIZACION, VISITA
  prioridad    String    @default("NORMAL") // BAJA, NORMAL, ALTA, URGENTE
  estado       String    @default("PENDIENTE") // PENDIENTE, EN_PROGRESO, COMPLETADA, CANCELADA
  fechaVence   DateTime?
  completadaEn DateTime?
  clienteId    String?
  cliente      Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  asignadoId   String?
  asignado     Usuario?  @relation(fields: [asignadoId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([estado])
  @@index([asignadoId])
  @@index([clienteId])
  @@index([fechaVence])
  @@map("tareas")
}

// ── Proveedores y compras (submódulo ERP) ──
model Proveedor {
  id           String   @id @default(cuid())
  nombre       String
  contacto     String?
  email        String?
  telefono     String?
  nit          String?
  direccion    String?
  ciudad       String?
  categorias   String[] @default([])
  notas        String?  @db.Text
  leadTimeDias Int? // tiempo de entrega estimado
  activo       Boolean  @default(true)

  // ── Ficha comercial ──
  whatsapp        String?
  paginaWeb       String?
  departamento    String?
  pais            String   @default("Colombia")
  // Segundo correo para copiar en los pedidos (compras, cartera…).
  emailAlterno    String?
  condicionesPago String? // "30 días", "contado", "50% anticipo"…
  moneda          String   @default("COP")
  /// Costamallas fabrica algunos productos. El proveedor marcado como
  /// propio identifica esos casos: sus productos NO entran en el KPI de
  /// "por reabastecer", porque no se le compran a nadie.
  esPropio        Boolean  @default(false)
  calificacion    Int? // 1 a 5, evaluación interna
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ordenes   OrdenCompra[]
  productos ProveedorProducto[]

  @@index([activo])
  @@index([esPropio])
  @@map("proveedores")
}

/// Qué productos nos provee cada proveedor, con su referencia y precio.
/// Un producto puede tener varios proveedores (para comparar) y uno se
/// marca como preferido para armar los pedidos automáticamente.
model ProveedorProducto {
  id          String    @id @default(cuid())
  proveedorId String
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  productoId  String
  producto    Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)

  /// Código con el que el proveedor identifica el producto en SU catálogo.
  referencia   String?
  precioCompra Decimal? @db.Decimal(14, 2)
  /// Cantidad mínima que acepta por pedido.
  minimoPedido Int?
  leadTimeDias Int?
  preferido    Boolean  @default(false)
  notas        String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([proveedorId, productoId])
  @@index([productoId])
  @@index([preferido])
  @@map("proveedor_productos")
}

model OrdenCompra {
  id            String    @id @default(cuid())
  numero        String    @unique
  proveedorId   String
  proveedor     Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  estado        String    @default("BORRADOR") // BORRADOR, ENVIADA, RECIBIDA_PARCIAL, RECIBIDA, CANCELADA
  total         Decimal   @default(0) @db.Decimal(14, 2)
  notas         String?   @db.Text
  items         Json      @default("[]")
  fechaEsperada DateTime?
  recibidaEn    DateTime?

  // ── Envío al proveedor por correo ──
  enviadaEn     DateTime?
  enviadaAEmail String?
  /// Error del último intento de envío. Sirve para reintentar sabiendo
  /// por qué falló, en vez de dejar la orden en un limbo silencioso.
  errorEnvio    String?   @db.Text
  creadaPorId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([proveedorId])
  @@index([estado])
  @@map("ordenes_compra")
}

// ── Plantillas y automatización (submódulo Nexus) ──
model PlantillaNexus {
  id         String   @id @default(cuid())
  nombre     String
  categoria  String   @default("GENERAL") // GENERAL, SALUDO, COTIZACION, SEGUIMIENTO, DESPEDIDA, FAQ
  canal      String   @default("todos") // todos, whatsapp, email, instagram...
  contenido  String   @db.Text
  atajo      String? // ej: /saludo
  activo     Boolean  @default(true)
  vecesUsada Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([categoria])
  @@index([activo])
  @@map("plantillas_nexus")
}

model Cotizacion {
  id               String   @id @default(cuid())
  numero           String   @unique
  clienteId        String
  cliente          Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  vendedorId       String?
  vendedor         Usuario? @relation(fields: [vendedorId], references: [id], onDelete: SetNull)
  estado           String   @default("BORRADOR")
  subtotal         Decimal  @default(0) @db.Decimal(14, 2)
  descuento        Decimal  @default(0) @db.Decimal(14, 2)
  iva              Decimal  @default(0) @db.Decimal(14, 2)
  total            Decimal  @default(0) @db.Decimal(14, 2)

  // ── AIU: Administración, Imprevistos y Utilidad ──
  /// Así se cotiza una obra en Colombia, y cambia el IVA por completo:
  /// en un contrato de construcción el IVA va sobre la UTILIDAD, no
  /// sobre el valor del contrato. Medido contra una cotización real de
  /// la empresa, el portal cobraba diez veces el IVA que corresponde.
  ///
  /// Nace apagado: las ofertas de material suelto se calculan igual que
  /// siempre y las que ya existían no cambian de total.
  aiuActivo      Boolean @default(false)
  /// Base del AIU = subtotal de los ítems de INSTALACIÓN (la obra). El
  /// material va aparte, con su 19 % normal.
  aiuAdminPct    Decimal @default(10) @db.Decimal(5, 2)
  aiuImprevPct   Decimal @default(5)  @db.Decimal(5, 2)
  aiuUtilidadPct Decimal @default(10) @db.Decimal(5, 2)
  /// El monto es la verdad —es lo que se cobra—; el porcentaje queda
  /// para mostrarlo en el documento. En las hojas de la empresa la
  /// administración y los imprevistos se negocian como suma fija, así
  /// que el asesor puede escribir el monto y el % pasa a ser informativo.
  aiuAdmin       Decimal @default(0) @db.Decimal(14, 2)
  aiuImprev      Decimal @default(0) @db.Decimal(14, 2)
  aiuUtilidad    Decimal @default(0) @db.Decimal(14, 2)
  /// Parte del IVA que corresponde a la utilidad. `iva` sigue siendo el
  /// IVA TOTAL, para no romper cartera, facturación ni los reportes.
  ivaUtilidad    Decimal @default(0) @db.Decimal(14, 2)
  validezDias      Int      @default(30)
  notas            String?  @db.Text
  tieneInstalacion Boolean  @default(false)

  /// EXPRESS (1-2 hojas, para producto suelto, que es la mayoría) o
  /// PROPUESTA (dossier con portada, para cerramientos e instalaciones).
  plantilla String @default("EXPRESS")

  // ── Enlace público que se le comparte al cliente ──
  /// Token del enlace. Es distinto del id para que nadie adivine una
  /// cotización ajena cambiando un número en la URL.
  publicId       String?   @unique
  vistaPrimeraEn DateTime?
  vistaUltimaEn  DateTime?
  vistas         Int       @default(0)

  // ── Envío al cliente ──
  enviadaEn     DateTime?
  enviadaAEmail String?
  errorEnvio    String?   @db.Text

  /// Dónde se instala: define el recargo por desplazamiento y sale en el PDF.
  ciudadInstalacion    String?
  direccionInstalacion String?

  /// Plazo propio de esta oferta. Nulo = se usa el texto general de
  /// Configuración → Cotización. El general dice "de 2 a 5 días hábiles"
  /// y hay obras que se demoran 15: sin esto el asesor mandaba una
  /// promesa que no se iba a cumplir.
  tiempoEntrega        String?

  // ── Seguimiento post-cotización ──
  /// Se puede apagar por cotización: hay negocios donde el cliente pide
  /// expresamente que no lo persigan, y un recordatorio automático ahí
  /// hace más daño que bien.
  seguimientoActivo Boolean @default(true)

  // ── Política comercial (tope de descuento y anticipo) ──
  /// Descuento concedido como porcentaje del subtotal. El monto por sí
  /// solo no permite comparar contra un tope en porcentaje.
  descuentoPct      Decimal   @default(0) @db.Decimal(5, 2)
  /// Anticipo pactado. Nulo = se aplica el mínimo de la configuración.
  anticipoPct       Decimal?  @db.Decimal(5, 2)
  /// NO_REQUIERE · PENDIENTE · APROBADA · RECHAZADA
  aprobacionEstado  String    @default("NO_REQUIERE")
  /// Por qué quedó pidiendo visto bueno (descuento, anticipo o ambos).
  aprobacionMotivo  String?   @db.Text
  aprobadaPorId     String?
  aprobadaPorNombre String?
  aprobadaEn        DateTime?
  aprobacionNota    String?   @db.Text

  // ── Cotización de PRUEBA ──
  /// Solo el superadministrador las crea. Van marcadas en pantalla y
  /// quedan FUERA de informes, embudo, pipeline y del consecutivo real:
  /// llevan numeración aparte (PRUEBA-001) para no quemar números de COT.
  /// La marca se hereda al pedido y a todo lo que nazca de ellas.
  esPrueba Boolean @default(false)

  // ── Trabajo previo que hay que coordinar con producción ──
  /// Hace falta ir a medir antes de cotizar en firme. Al coordinador le
  /// llega la solicitud en su módulo de trabajos.
  requiereVisita Boolean @default(false)
  /// Habilita al coordinador la carga de documentos por trabajador.
  requiereSgsst  Boolean @default(false)

  // ── Aplazar el vencimiento ──
  /// El vencimiento sale de createdAt + validezDias. La prórroga se
  /// guarda APARTE y no sumada a validezDias, para que el documento siga
  /// diciendo la validez que se le ofreció al cliente y quede claro
  /// cuánto se estiró después.
  prorrogaDias    Int       @default(0)
  /// Cuántas veces se aplazó. El vendedor tiene tope de 2; un
  /// administrador no tiene tope.
  prorrogas       Int       @default(0)
  prorrogadaEn    DateTime?
  prorrogadaPorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items        ItemCotizacion[]
  pedidos      Pedido[]
  seguimientos SeguimientoCotizacion[]
  visita       VisitaTecnica?
  sgsst        SgsstPersona[]

  @@index([clienteId])
  @@index([vendedorId])
  @@index([estado])
  @@index([aprobacionEstado])
  @@index([esPrueba])
  @@map("cotizaciones")
}

/// La visita técnica previa a cotizar en firme.
///
/// Base: el formato "F. Visita tecnica.xlsx" de la empresa. Los datos
/// del formulario van en JSON y no en 30 columnas porque el formato
/// tiene dos bloques muy distintos —cerca eléctrica y malla invisible— y
/// una columna por casilla obligaría a migrar la base cada vez que
/// producción añada una medida.
model VisitaTecnica {
  id           String     @id @default(cuid())
  cotizacionId String     @unique
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  /// SOLICITADA · AGENDADA · REALIZADA · CANCELADA
  estado          String    @default("SOLICITADA")
  solicitadaPorId String?
  coordinadorId   String?
  fechaAgendada   DateTime?
  fechaRealizada  DateTime?

  direccion String?
  ciudad    String?
  contacto  String?
  telefono  String?

  /// El formulario lleno. Ver lib/visita-tecnica.ts para las secciones.
  datos       Json @default("{}")
  /// [{ url, titulo, momento }]
  fotos       Json @default("[]")
  /// El FORMATO REQUISICION DE MATERIALES Y HERRAMIENTAS que producción
  /// entrega al volver.
  requisicion Json @default("{}")

  observaciones String? @db.Text
  /// Cuándo producción entregó la visita y la oportunidad volvió a
  /// "pendiente cotización" del lado del vendedor.
  devueltaEn    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
  @@map("visitas_tecnicas")
}

/// Una PERSONA del proceso SG-SST, con sus documentos.
///
/// La carga es por persona de una vez —cédula, planilla, alturas— y no
/// documento a documento, porque así es como llegan: el contratista
/// manda la carpeta de un trabajador completa.
model SgsstPersona {
  id           String     @id @default(cuid())
  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  nombre String
  cedula String?
  /// TRABAJADOR · COORD_SST · COORD_ALTURAS
  rol    String @default("TRABAJADOR")

  /// Qué documentos aplican a esta persona. Son casillas OPCIONALES: no
  /// todo trabajador necesita certificado de alturas.
  requeridos Json @default("{}")
  /// Lo entregado: [{ tipo, nombreArchivo, tamano, subidoEn, subidoPorId,
  /// almacenado, motivo }].
  ///
  /// ⚠️ `almacenado` es false mientras no haya dónde guardarlos. Son
  /// datos personales: no van al FTP (roto) ni a la biblioteca pública de
  /// WordPress. Hasta la migración al VPS se registra QUÉ documento se
  /// entregó y cuándo, y la pantalla lo dice con todas las letras.
  documentos Json @default("[]")

  observaciones String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cotizacionId])
  @@map("sgsst_personas")
}

/// Los tres toques posteriores al envío de una oferta. Existen como
/// tabla y no como columnas de la cotización porque hay que saber qué
/// se mandó, cuándo, por dónde y si falló: un booleano "ya se contactó"
/// no permite explicarle nada a nadie después.
model SeguimientoCotizacion {
  id           String     @id @default(cuid())
  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  /// 1 = confirmar recibido (automático) · 2 = llamada del asesor
  /// (persona) · 3 = cierre por vencimiento (automático).
  toque          Int
  /// EMAIL · WHATSAPP · TAREA
  canal          String    @default("EMAIL")
  /// PENDIENTE · ENVIADO · HECHO · ERROR · OMITIDO
  estado         String    @default("PENDIENTE")
  programadoPara DateTime
  ejecutadoEn    DateTime?
  destino        String?
  /// El texto que se envió. Queda guardado para poder explicar después
  /// qué fue exactamente lo que recibió el cliente.
  mensaje        String?   @db.Text
  error          String?   @db.Text

  /// Toque 2: la tarea que se le creó al asesor, y cuándo se le avisó a
  /// gerencia que no la había atendido.
  tareaId         String?
  alertaEnviadaEn DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cotizacionId, toque])
  @@index([estado])
  @@index([programadoPara])
  @@map("seguimientos_cotizacion")
}

model ItemCotizacion {
  id             String     @id @default(cuid())
  cotizacionId   String
  cotizacion     Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  productoId     String?
  descripcion    String
  cantidad       Decimal    @db.Decimal(10, 2)
  precioUnitario Decimal    @db.Decimal(14, 2)
  descuento      Decimal    @default(0) @db.Decimal(5, 2)
  subtotal       Decimal    @db.Decimal(14, 2)
  unidad         String?
  orden          Int        @default(0)

  /// PRODUCTO o INSTALACION. La instalación va como ítem aparte porque su
  /// precio no depende solo del producto, sino también de la ciudad.
  tipo      String  @default("PRODUCTO")
  /// Foto que se muestra en la cotización. Se copia del catálogo al cotizar
  /// para que la oferta enviada no cambie si después se edita el producto.
  imagenUrl String?
  /// Detalle largo (medidas, acabado, observaciones) que sale bajo el nombre.
  detalle   String? @db.Text

  @@index([cotizacionId])
  @@map("items_cotizacion")
}

// ── Catálogo de instalación (submódulo CRM) ──

/// Servicios de instalación que el asesor puede agregar a una cotización.
/// Antes la instalación era un sí/no que solo pintaba un sello: no tenía
/// precio propio ni quedaba discriminada en la oferta.
model ServicioInstalacion {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?  @db.Text
  /// m2, ml (metro lineal), unidad, dia…
  unidad      String   @default("m2")
  precioBase  Decimal  @default(0) @db.Decimal(14, 2)
  /// Categorías de producto a las que aplica, para sugerir solo lo que
  /// tiene sentido según lo que ya está cotizado.
  categorias  String[] @default([])
  /// Cantidad mínima facturable (una instalación de 2 m² no se cobra a 2 m²).
  minimoCobro Decimal? @db.Decimal(10, 2)
  activo      Boolean  @default(true)
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([activo])
  @@map("servicios_instalacion")
}

/// Recargo por desplazamiento fuera de la ciudad base (viáticos).
/// "No vale lo mismo instalar en Barranquilla que mandar el personal a
/// Santa Marta, Cartagena o Montería."
model RecargoCiudad {
  id           String   @id @default(cuid())
  ciudad       String   @unique
  departamento String?
  /// Porcentaje sobre el valor de la instalación.
  porcentaje   Decimal  @default(0) @db.Decimal(5, 2)
  /// Monto fijo adicional, para cuando el viático se cobra completo y no
  /// como porcentaje. Se suman los dos si ambos están puestos.
  montoFijo    Decimal  @default(0) @db.Decimal(14, 2)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("recargos_ciudad")
}

model Pedido {
  id               String      @id @default(cuid())
  numero           String      @unique
  cotizacionId     String?
  cotizacion       Cotizacion? @relation(fields: [cotizacionId], references: [id], onDelete: SetNull)
  clienteId        String
  cliente          Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  vendedorId       String?
  vendedor         Usuario?    @relation(fields: [vendedorId], references: [id], onDelete: SetNull)
  estado           String      @default("NUEVO")
  tieneInstalacion Boolean     @default(false)

  /// De dónde viene el pedido: WEB (tienda), MANUAL (lo creó un asesor),
  /// COTIZACION (nació de una cotización aprobada), NEXUS (chat) o
  /// MARKETPLACE. Antes se deducía de `!tieneInstalacion`, lo que
  /// etiquetaba como "web" cualquier pedido telefónico sin instalación.
  origen    String  @default("MANUAL")
  /// Referencia en el sistema de origen (nº de pedido de WooCommerce, etc.).
  origenRef String?

  /// Desde cuándo está en el estado actual. Sin esto, "días en etapa" hay
  /// que sacarlo de updatedAt, que cambia por cualquier edición y hace
  /// que un pedido estancado parezca recién movido.
  estadoDesde DateTime?

  /// Nació de una cotización de prueba. La marca se hereda para que un
  /// pedido de mentira no ensucie el pipeline ni la plata del embudo.
  esPrueba Boolean @default(false)

  fechaEntrega     DateTime?
  direccionEntrega String?
  notas            String?   @db.Text
  total            Decimal   @default(0) @db.Decimal(14, 2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  items       ItemPedido[]
  instalacion Instalacion?

  @@index([clienteId])
  @@index([vendedorId])
  @@index([estado])
  @@map("pedidos")
}

model ItemPedido {
  id             String  @id @default(cuid())
  pedidoId       String
  pedido         Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId     String?
  descripcion    String
  cantidad       Decimal @db.Decimal(10, 2)
  precioUnitario Decimal @db.Decimal(14, 2)
  subtotal       Decimal @db.Decimal(14, 2)
  unidad         String?
  orden          Int     @default(0)

  @@index([pedidoId])
  @@map("items_pedido")
}

model Instalacion {
  id             String    @id @default(cuid())
  pedidoId       String    @unique
  pedido         Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  tecnicoId      String?
  tecnico        Usuario?  @relation(fields: [tecnicoId], references: [id], onDelete: SetNull)
  estado         String    @default("PENDIENTE")
  fechaAgendada  DateTime?
  fechaRealizada DateTime?
  direccion      String?
  ciudad         String?
  notas          String?   @db.Text

  /// Evidencia de la obra: [{ url, titulo, momento: "ANTES"|"DESPUES" }].
  /// Es el respaldo cuando un cliente reclama garantía por algo que ya
  /// estaba dañado, o dice que no se hizo lo que se hizo.
  fotos     Json @default("[]")
  /// Checklist de cierre: [{ texto, hecho }]. La obra no se marca como
  /// terminada con puntos sin cumplir.
  checklist Json @default("[]")

  // ── Acta de entrega ──
  actaFirmadaEn      DateTime?
  /// Quién recibió la obra en sitio: no siempre es quien compró.
  actaRecibidoPor    String?
  actaDocumento      String?
  actaObservaciones  String?   @db.Text
  encuestas          EncuestaSatisfaccion[]
  /// Sello del CORREO al coordinador de proyectos. Evita escribirle dos
  /// veces por el mismo pedido. Solo se pone cuando el correo sale (o
  /// cuando no hay a quién escribirle): si el SMTP no está cargado se
  /// deja en blanco a propósito, para que el aviso salga el día que se
  /// carguen las credenciales.
  avisoCoordinadorEn DateTime?
  /// Sello de la NOTIFICACIÓN del portal. Va aparte del anterior porque
  /// son dos cosas distintas, y confundirlas costaba notificaciones
  /// duplicadas: sin SMTP el aviso nunca se sellaba, así que cada
  /// reaprobación de la cotización creaba otra igual.
  avisoPortalEn      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
  @@index([tecnicoId])
  /// Heredado del pedido. Ver lib/cotizaciones-prueba.ts
  esPrueba Boolean @default(false)

  @@index([esPrueba])

  @@map("instalaciones")
}

/// Respuesta del cliente a la encuesta de satisfacción.
///
/// Los campos salen del "Formato Valoración de cliente" de la empresa:
/// NPS, seis puntajes de 0 a 10, recompra y dos textos libres.
///
/// Tabla propia y no un JSON en `configuracion` porque esto se promedia,
/// se filtra por asesor y se mira por mes. Un JSON que hay que parsear
/// entero para sacar un promedio deja de servir a las cien respuestas.
model EncuestaSatisfaccion {
  id String @id @default(cuid())

  /// Con qué obra tiene que ver. Nulo si la instalación se borró: la
  /// respuesta sigue valiendo para el promedio.
  instalacionId String?
  instalacion   Instalacion? @relation(fields: [instalacionId], references: [id], onDelete: SetNull)
  clienteId     String?
  cliente       Cliente?     @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  /// De quién fue la venta. Se copia al crearla porque el cliente puede
  /// cambiar de asesor después y eso falsearía el informe.
  vendedorId    String?

  /// El secreto del enlace del correo. Distinto del id para que nadie
  /// conteste por otro cambiando un número.
  token String @unique

  /// NPS: "¿con qué probabilidad nos recomendaría?", de 0 a 10.
  recomendaria Int?

  // Los seis puntajes del formato, de 0 a 10.
  calidad         Int?
  precio          Int?
  profesionalidad Int?
  atencion        Int?
  puntualidad     Int?
  limpieza        Int?

  recompra        Int?
  destacaria      String? @db.Text
  recomendaciones String? @db.Text

  /// Las dos fechas separadas: sin ellas no se puede saber cuántas se
  /// responden ni en cuánto tiempo.
  enviadaEn    DateTime?
  respondidaEn DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instalacionId])
  @@index([respondidaEn])
  @@map("encuestas_satisfaccion")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  usuarioId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  @@index([token])
  @@index([usuarioId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// PRODUCTOS
// ─────────────────────────────────────────────

model Producto {
  id          String       @id @default(cuid())
  wcId        Int?         @unique
  tipo        TipoProducto @default(SIMPLE)
  sku         String       @unique
  nombre      String
  slug        String       @unique
  publicado   Boolean      @default(false)
  visibilidad String       @default("visible")
  destacado   Boolean      @default(false)

  descCorta   String? @db.Text
  descripcion String? @db.Text

  // SEO (autogenerado con IA)
  seoTitulo      String?
  seoDescripcion String?  @db.Text
  seoKeywords    String[] @default([])
  seoTexto       String?  @db.Text

  precioNormal Decimal? @db.Decimal(14, 2)
  precioOferta Decimal? @db.Decimal(14, 2)

  estadoImpuesto String?
  claseImpuesto  String?

  /// No admite descuento POR LÍNEA (margen mínimo). Sí entra en el
  /// descuento global de la oferta: el global es una decisión sobre el
  /// negocio completo, no sobre este producto en particular.
  sinDescuento Boolean @default(false)

  enStock           Boolean @default(true)
  stock             Int     @default(0)
  stockMinimo       Int     @default(15)
  permiteBackorders String  @default("no")

  pesoKg  Decimal? @db.Decimal(8, 3)
  largoCm Decimal? @db.Decimal(8, 2)
  anchoCm Decimal? @db.Decimal(8, 2)
  altoCm  Decimal? @db.Decimal(8, 2)

  categorias     String[]
  etiquetas      String[]
  claseEnvio     String?
  notaCompra     String?  @db.Text
  permiteResenas Boolean  @default(true)

  // Campos ACF Generales
  acfSkuInterno        String?
  acfMarcaFabricante   String?
  acfUnidadVenta       String?
  acfFabricacionMedida Boolean  @default(false)
  acfInstalacion       Boolean  @default(false)
  acfGarantiaAnos      Int?
  acfAplicaciones      String[]
  acfColores           String[]
  acfNormas            String[]
  acfFichaTecnicaPdf   String?
  acfCertificaciones   String[]
  acfExtra             Json     @default("{}")

  // Control interno
  intEstado        EstadoProducto @default(BORRADOR)
  intResponsable   String?
  intObservaciones String?        @db.Text
  intListoExportar Boolean        @default(false)
  intExportadoEn   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  imagenes      AcfImagen[]
  errores       ErrorValidacion[]
  proveedores   ProveedorProducto[]
  seoPropuestas SeoPropuesta[]

  acfMM AcfMallasMetalicas?
  acfBH AcfBalcones?
  acfNY AcfNylon?
  acfPL AcfPlasticas?
  acfSP AcfSeguridadPerimetral?

  @@index([sku])
  @@index([intEstado])
  @@index([publicado])
  @@index([categorias])
  @@map("productos")
}

enum TipoProducto {
  SIMPLE
  VARIABLE
  AGRUPADO
  EXTERNO
}

enum EstadoProducto {
  BORRADOR
  REVISION
  LISTO
  PUBLICADO
  ARCHIVADO
}

// ─────────────────────────────────────────────
// IMÁGENES
// ─────────────────────────────────────────────

/// Cola de revisión del SEO generado por IA.
///
/// El generador iba de a UNO y ni siquiera guardaba: devolvía el texto
/// para que una persona lo pegara. Hacer 175 productos era abrir 175
/// fichas a mano.
///
/// ⚠️ Es una COLA y no escritura directa a propósito: guardar un
/// producto dispara la sincronización con WooCommerce, así que lo que
/// se escriba sale publicado en costamallas.com. Texto de IA sin leer,
/// en la tienda, a nombre de la empresa. Aquí se genera en lote, queda
/// en PROPUESTO, y alguien aprueba o rechaza producto por producto.
model SeoPropuesta {
  id         String   @id @default(cuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  /// PROPUESTO · APROBADO · RECHAZADO · ERROR
  estado String @default("PROPUESTO")
  /// Agrupa las propuestas de una misma corrida.
  loteId String?

  seoTitulo      String   @default("")
  seoDescripcion String   @default("") @db.Text
  seoKeywords    String[] @default([])
  seoTexto       String   @default("") @db.Text
  slug           String   @default("")
  /// [{ id, altText, titulo }] por cada imagen del producto.
  imagenes       Json     @default("[]")

  /// ⚠️ Cambiar el slug de un producto YA publicado rompe la URL que
  /// Google tiene indexada. El slug propuesto NO se aplica salvo que
  /// alguien lo marque a mano.
  aplicaSlug Boolean @default(false)

  modelo        String?
  tokensEntrada Int     @default(0)
  tokensSalida  Int     @default(0)
  costoUSD      Float   @default(0)
  error         String?

  generadoPor String?
  revisadoPor String?
  revisadoEn  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
  @@index([productoId])
  @@index([loteId])
  @@map("seo_propuestas")
}

model AcfImagen {
  id          String   @id @default(cuid())
  productoId  String
  producto    Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  posicion    Int      @default(0)
  urlImagen   String
  altText     String?
  titulo      String?
  esPrincipal Boolean  @default(false)
  urlValida   Boolean?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productoId])
  @@map("imagenes")
}

// ─────────────────────────────────────────────
// ACF POR CATEGORÍA
